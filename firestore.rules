rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped owner email check (requires verified email; zero DB lookups so safe in allow list)
    function isBootstrappedAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        'email_verified' in request.auth.token &&
        request.auth.token.email == 'mdabdussubahan292@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Full admin check for single-document reads & writes
    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION HELPERS ---
    function isValidAdminRecord(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidProduct(data) {
      return data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             (!('nameBn' in data) || (data.nameBn is string && data.nameBn.size() <= 200)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 4000)) &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128 &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 120)) &&
             data.price is number && data.price >= 0 && data.price <= 10000000 &&
             (!('previousPrice' in data) || (data.previousPrice is number && data.previousPrice >= 0 && data.previousPrice <= 10000000)) &&
             (!('discountPercent' in data) || (data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 95)) &&
             data.stockQuantity is int && data.stockQuantity >= 0 && data.stockQuantity <= 1000000 &&
             (!('colors' in data) || (data.colors is list && data.colors.size() <= 15 && (data.colors.size() == 0 || data.colors[0] is string))) &&
             (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 15 && (data.sizes.size() == 0 || data.sizes[0] is string))) &&
             (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 6 && (data.imageUrls.size() == 0 || data.imageUrls[0] is string))) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
             (!('deliveryChargeOverride' in data) || (data.deliveryChargeOverride is number && data.deliveryChargeOverride >= -1 && data.deliveryChargeOverride <= 50000)) &&
             (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 1000)) &&
             data.isPublished is bool &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('isBestSelling' in data) || data.isBestSelling is bool) &&
             (!('isNewArrival' in data) || data.isNewArrival is bool) &&
             (!('isFlashSale' in data) || data.isFlashSale is bool) &&
             (!('isChoiceDay' in data) || data.isChoiceDay is bool) &&
             (!('isBundleEligible' in data) || data.isBundleEligible is bool) &&
             (!('soldCount' in data) || (data.soldCount is int && data.soldCount >= 0)) &&
             (!('ratingAvg' in data) || (data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5)) &&
             (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProductCost(data) {
      return data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 10000000 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 100 &&
             (!('iconKey' in data) || (data.iconKey is string && data.iconKey.size() <= 50)) &&
             (!('sortOrder' in data) || (data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000)) &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStoreConfig(data) {
      return data.isPublicConfig is bool &&
             data.insideBoguraCharge is number && data.insideBoguraCharge >= 0 && data.insideBoguraCharge <= 5000 &&
             data.outsideBoguraCharge is number && data.outsideBoguraCharge >= 0 && data.outsideBoguraCharge <= 5000 &&
             data.insideDhakaCharge is number && data.insideDhakaCharge >= 0 && data.insideDhakaCharge <= 5000 &&
             data.outsideDhakaCharge is number && data.outsideDhakaCharge >= 0 && data.outsideDhakaCharge <= 5000 &&
             data.nationwideCharge is number && data.nationwideCharge >= 0 && data.nationwideCharge <= 5000 &&
             (!('perKgExtraCharge' in data) || (data.perKgExtraCharge is number && data.perKgExtraCharge >= 0 && data.perKgExtraCharge <= 1000)) &&
             (!('perExtraItemCharge' in data) || (data.perExtraItemCharge is number && data.perExtraItemCharge >= 0 && data.perExtraItemCharge <= 1000)) &&
             (!('freeDeliveryMinOrder' in data) || (data.freeDeliveryMinOrder is number && data.freeDeliveryMinOrder >= 0 && data.freeDeliveryMinOrder <= 1000000)) &&
             (!('freeDeliveryActive' in data) || data.freeDeliveryActive is bool) &&
             data.codEnabled is bool &&
             (!('bkashEnabled' in data) || data.bkashEnabled is bool) &&
             (!('bkashNumber' in data) || (data.bkashNumber is string && data.bkashNumber.size() <= 30)) &&
             (!('nagadEnabled' in data) || data.nagadEnabled is bool) &&
             (!('nagadNumber' in data) || (data.nagadNumber is string && data.nagadNumber.size() <= 30)) &&
             (!('rocketEnabled' in data) || data.rocketEnabled is bool) &&
             (!('rocketNumber' in data) || (data.rocketNumber is string && data.rocketNumber.size() <= 30)) &&
             (!('bankEnabled' in data) || data.bankEnabled is bool) &&
             (!('bankDetails' in data) || (data.bankDetails is string && data.bankDetails.size() <= 1000)) &&
             (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120)) &&
             (!('businessNameBn' in data) || (data.businessNameBn is string && data.businessNameBn.size() <= 120)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 300)) &&
             (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 30)) &&
             (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 300)) &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30)) &&
             (!('aboutUs' in data) || (data.aboutUs is string && data.aboutUs.size() <= 3000)) &&
             (!('privacyPolicy' in data) || (data.privacyPolicy is string && data.privacyPolicy.size() <= 4000)) &&
             (!('returnPolicy' in data) || (data.returnPolicy is string && data.returnPolicy.size() <= 4000)) &&
             (!('deliveryPolicy' in data) || (data.deliveryPolicy is string && data.deliveryPolicy.size() <= 4000)) &&
             (!('flashSaleTitle' in data) || (data.flashSaleTitle is string && data.flashSaleTitle.size() <= 200)) &&
             (!('flashSaleActive' in data) || data.flashSaleActive is bool) &&
             (!('flashSaleDurationHours' in data) || (data.flashSaleDurationHours is int && data.flashSaleDurationHours >= 0 && data.flashSaleDurationHours <= 720)) &&
             (!('buy2DiscountPercent' in data) || (data.buy2DiscountPercent is int && data.buy2DiscountPercent >= 0 && data.buy2DiscountPercent <= 90)) &&
             (!('buy3DiscountPercent' in data) || (data.buy3DiscountPercent is int && data.buy3DiscountPercent >= 0 && data.buy3DiscountPercent <= 90)) &&
             (!('newCustomerDiscountPercent' in data) || (data.newCustomerDiscountPercent is int && data.newCustomerDiscountPercent >= 0 && data.newCustomerDiscountPercent <= 90)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() >= 2 && data.code.size() <= 32 &&
             data.discountType in ['PERCENT', 'FIXED'] &&
             data.discountValue is number && data.discountValue >= 0 && data.discountValue <= 100000 &&
             (!('minOrderAmount' in data) || (data.minOrderAmount is number && data.minOrderAmount >= 0)) &&
             (!('maxDiscountAmount' in data) || (data.maxDiscountAmount is number && data.maxDiscountAmount >= 0)) &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('altPhone' in data) || (data.altPhone is string && data.altPhone.size() <= 30)) &&
             (!('defaultAddress' in data) || (data.defaultAddress is string && data.defaultAddress.size() <= 500)) &&
             (!('division' in data) || (data.division is string && data.division.size() <= 80)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 80)) &&
             (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 80)) &&
             (!('deliveryArea' in data) || (data.deliveryArea is string && data.deliveryArea.size() <= 80)) &&
             (!('languagePref' in data) || data.languagePref in ['bn', 'en']) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCartItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 200 &&
             (!('productNameBn' in data) || (data.productNameBn is string && data.productNameBn.size() <= 200)) &&
             (!('sku' in data) || (data.sku is string && data.sku.size() <= 64)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
             data.unitPrice is number && data.unitPrice >= 0 &&
             (!('previousPrice' in data) || (data.previousPrice is number && data.previousPrice >= 0)) &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 500 &&
             (!('selectedColor' in data) || (data.selectedColor is string && data.selectedColor.size() <= 60)) &&
             (!('selectedSize' in data) || (data.selectedSize is string && data.selectedSize.size() <= 60)) &&
             (!('deliveryChargeOverride' in data) || (data.deliveryChargeOverride is number && data.deliveryChargeOverride >= -1)) &&
             (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWishlistItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 200 &&
             (!('productNameBn' in data) || (data.productNameBn is string && data.productNameBn.size() <= 200)) &&
             data.price is number && data.price >= 0 &&
             (!('previousPrice' in data) || (data.previousPrice is number && data.previousPrice >= 0)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
             (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 120)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 64 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 6 && data.mobileNumber.size() <= 30 &&
             (!('altMobileNumber' in data) || (data.altMobileNumber is string && data.altMobileNumber.size() <= 30)) &&
             data.fullAddress is string && data.fullAddress.size() >= 3 && data.fullAddress.size() <= 500 &&
             (!('division' in data) || (data.division is string && data.division.size() <= 80)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 80)) &&
             (!('upazila' in data) || (data.upazila is string && data.upazila.size() <= 80)) &&
             data.deliveryArea is string && data.deliveryArea.size() >= 1 && data.deliveryArea.size() <= 80 &&
             (!('orderNote' in data) || (data.orderNote is string && data.orderNote.size() <= 500)) &&
             data.paymentMethod in ['COD', 'BKASH', 'NAGAD', 'ROCKET', 'BANK'] &&
             (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 100)) &&
             (!('senderPhone' in data) || (data.senderPhone is string && data.senderPhone.size() <= 30)) &&
             (!('itemsSummary' in data) || (data.itemsSummary is string && data.itemsSummary.size() <= 1000)) &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.deliveryCharge is number && data.deliveryCharge >= 0 &&
             data.discountAmount is number && data.discountAmount >= 0 &&
             (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 32)) &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             (!('totalCost' in data) || (data.totalCost is number && data.totalCost >= 0)) &&
             data.status in ['Pending', 'Confirmed', 'Processing', 'Shipped', 'Delivered', 'Cancelled', 'Returned'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             (!('titleBn' in data) || (data.titleBn is string && data.titleBn.size() <= 200)) &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
             (!('messageBn' in data) || (data.messageBn is string && data.messageBn.size() <= 1000)) &&
             data.type in ['PROMO', 'NEW_PRODUCT', 'ORDER_UPDATE', 'DISCOUNT'] &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
             data.isRead is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(uid) &&
                       incoming().keys().hasAll(['uid', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'createdAt']) &&
                       isValidAdminRecord(incoming());
      allow update: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminRecord(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (existing().isPublished == true || isAdmin());
      allow list: if isSignedIn() && (existing().isPublished == true || isBootstrappedAdmin());
      allow create: if isAdmin() && isValidId(productId) &&
                       incoming().keys().hasAll(['sku', 'name', 'categoryId', 'price', 'stockQuantity', 'isPublished', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['sku', 'name', 'nameBn', 'description', 'details', 'categoryId', 'categoryName', 'price', 'previousPrice', 'discountPercent', 'stockQuantity', 'colors', 'sizes', 'imageUrls', 'videoUrl', 'deliveryChargeOverride', 'weightKg', 'isPublished', 'isFeatured', 'isBestSelling', 'isNewArrival', 'isFlashSale', 'isChoiceDay', 'isBundleEligible', 'soldCount', 'ratingAvg', 'reviewCount', 'createdAt', 'updatedAt']) &&
                       isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().isPublished == true &&
                           incoming().stockQuantity <= existing().stockQuantity &&
                           incoming().soldCount >= existing().soldCount &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'soldCount', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(productId);

      match /reviews/{reviewId} {
        allow get: if isSignedIn() && isValidId(productId) && isValidId(reviewId) && existing().rating >= 1;
        allow list: if isSignedIn() && existing().rating >= 1;
        allow create: if isSignedIn() && isValidId(productId) && isValidId(reviewId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().productId == productId &&
                         incoming().keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt', 'updatedAt']) &&
                         isValidReview(incoming()) &&
                         exists(/databases/$(database)/documents/products/$(productId));
        allow update: if isSignedIn() && isValidId(productId) && isValidId(reviewId) &&
                         isValidReview(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt && (
                           isAdmin() ||
                           (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'userName', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(productId) && isValidId(reviewId) &&
                         (existing().userId == request.auth.uid || isAdmin());
      }
    }

    match /product_costs/{productId} {
      allow get: if isAdmin() && isValidId(productId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(productId) &&
                       incoming().keys().hasAll(['productId', 'costPrice', 'updatedAt']) &&
                       incoming().keys().hasOnly(['productId', 'costPrice', 'updatedAt']) &&
                       isValidProductCost(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProductCost(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (existing().isActive == true || isAdmin());
      allow list: if isSignedIn() && (existing().isActive == true || isBootstrappedAdmin());
      allow create: if isAdmin() && isValidId(categoryId) &&
                       incoming().keys().hasAll(['name', 'nameBn', 'isActive', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'nameBn', 'iconKey', 'sortOrder', 'isActive', 'createdAt', 'updatedAt']) &&
                       isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) &&
                       isValidCategory(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /store_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && (existing().isPublicConfig == true || isAdmin());
      allow list: if isSignedIn() && (existing().isPublicConfig == true || isBootstrappedAdmin());
      allow create: if isAdmin() && isValidId(configId) &&
                       incoming().keys().hasAll(['isPublicConfig', 'insideBoguraCharge', 'outsideBoguraCharge', 'insideDhakaCharge', 'outsideDhakaCharge', 'nationwideCharge', 'codEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['isPublicConfig', 'insideBoguraCharge', 'outsideBoguraCharge', 'insideDhakaCharge', 'outsideDhakaCharge', 'nationwideCharge', 'perKgExtraCharge', 'perExtraItemCharge', 'freeDeliveryMinOrder', 'freeDeliveryActive', 'codEnabled', 'bkashEnabled', 'bkashNumber', 'nagadEnabled', 'nagadNumber', 'rocketEnabled', 'rocketNumber', 'bankEnabled', 'bankDetails', 'businessName', 'businessNameBn', 'location', 'contactPhone', 'facebookUrl', 'whatsappNumber', 'aboutUs', 'privacyPolicy', 'returnPolicy', 'deliveryPolicy', 'flashSaleTitle', 'flashSaleActive', 'flashSaleDurationHours', 'buy2DiscountPercent', 'buy3DiscountPercent', 'newCustomerDiscountPercent', 'createdAt', 'updatedAt']) &&
                       isValidStoreConfig(incoming());
      allow update: if isAdmin() && isValidId(configId) &&
                       isValidStoreConfig(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(configId);
    }

    match /coupons/{couponId} {
      allow get: if isSignedIn() && isValidId(couponId) && (existing().isActive == true || isAdmin());
      allow list: if isSignedIn() && (existing().isActive == true || isBootstrappedAdmin());
      allow create: if isAdmin() && isValidId(couponId) &&
                       incoming().keys().hasAll(['code', 'discountType', 'discountValue', 'isActive', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['code', 'discountType', 'discountValue', 'minOrderAmount', 'maxDiscountAmount', 'isActive', 'createdAt', 'updatedAt']) &&
                       isValidCoupon(incoming());
      allow update: if isAdmin() && isValidId(couponId) &&
                       isValidCoupon(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(couponId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'phone', 'altPhone', 'defaultAddress', 'division', 'district', 'upazila', 'deliveryArea', 'languagePref', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'altPhone', 'defaultAddress', 'division', 'district', 'upazila', 'deliveryArea', 'languagePref', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

      match /cart/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'productId', 'productName', 'unitPrice', 'quantity', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'productId', 'productName', 'productNameBn', 'sku', 'imageUrl', 'unitPrice', 'previousPrice', 'quantity', 'selectedColor', 'selectedSize', 'deliveryChargeOverride', 'weightKg', 'createdAt', 'updatedAt']) &&
                         isValidCartItem(incoming());
        allow update: if isSignedIn() && isValidId(userId) && isValidId(itemId) &&
                         request.auth.uid == userId &&
                         isValidCartItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'selectedColor', 'selectedSize', 'unitPrice', 'previousPrice', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
      }

      match /wishlist/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'productId', 'productName', 'price', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'productId', 'productName', 'productNameBn', 'price', 'previousPrice', 'imageUrl', 'categoryName', 'createdAt', 'updatedAt']) &&
                         isValidWishlistItem(incoming());
        allow update: if isSignedIn() && isValidId(userId) && isValidId(itemId) &&
                         request.auth.uid == userId &&
                         isValidWishlistItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(orderId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'Pending' &&
                       incoming().keys().hasAll(['orderNumber', 'userId', 'customerName', 'mobileNumber', 'fullAddress', 'deliveryArea', 'paymentMethod', 'items', 'subtotal', 'deliveryCharge', 'discountAmount', 'totalAmount', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['orderNumber', 'userId', 'customerName', 'mobileNumber', 'altMobileNumber', 'fullAddress', 'division', 'district', 'upazila', 'deliveryArea', 'orderNote', 'paymentMethod', 'transactionId', 'senderPhone', 'itemsSummary', 'items', 'subtotal', 'deliveryCharge', 'discountAmount', 'couponCode', 'totalAmount', 'totalCost', 'status', 'createdAt', 'updatedAt']) &&
                       isValidOrder(incoming());
      allow update: if isSignedIn() && isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'Pending' &&
                           incoming().status == 'Cancelled' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || existing().userId == 'ALL' || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || existing().userId == 'ALL' || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(notificationId) &&
                       incoming().keys().hasAll(['userId', 'title', 'message', 'type', 'isRead', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'titleBn', 'message', 'messageBn', 'type', 'targetId', 'isRead', 'createdAt', 'updatedAt']) &&
                       isValidNotification(incoming()) &&
                       (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && isValidId(notificationId) &&
                       isValidNotification(incoming()) &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           incoming().userId == existing().userId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])
                         )
                       );
      allow delete: if isSignedIn() && isValidId(notificationId) && (isAdmin() || existing().userId == request.auth.uid);
    }
  }
}
